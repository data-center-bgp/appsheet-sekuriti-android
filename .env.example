# ============================================================
# Konfigurasi Supabase — WAJIB diisi agar aplikasi bisa jalan
# ------------------------------------------------------------
# Salin file ini menjadi ".env" lalu isi nilainya.
# Dapatkan nilai di: Supabase Dashboard > Project Settings > API
#   - Project URL  -> EXPO_PUBLIC_SUPABASE_URL
#   - anon public  -> EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# Catatan: variabel harus diawali "EXPO_PUBLIC_" agar terbaca di app.
# Setelah mengubah .env, RESTART dev server (nilai di-inline saat bundling).
# ============================================================

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
